# Local: leave blank to use embedded PostgreSQL (.data/staynest).
# Vercel: REQUIRED. Use a Neon/Supabase pooled PostgreSQL connection URL.
DATABASE_URL=
# REQUIRED on Vercel, at least 32 characters. npm run setup generates a local value.
SESSION_SECRET=
# Optional canonical public URL, e.g. https://staynest.vercel.app (no trailing slash).
APP_URL=
# Local defaults only. Never enable demo accounts on a public production deployment.
LOCAL_DEMO=true
LOCAL_DATABASE_PATH=.data/staynest
# Optional password-reset emails (Resend). Use your verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
# Shows password reset links locally; ignored on Vercel and in production.
DEV_EMAIL_PREVIEW=true
# Used only by npm run db:admin. Set a strong unique password, then remove it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StayNest Administrator
