{
  "name": "staynest",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --import tsx scripts/database.ts setup",
    "db:seed": "node --import tsx scripts/database.ts seed",
    "db:admin": "node --import tsx scripts/database.ts admin",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx scripts/smoke-test.ts",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@next/env": "16.4.2",
    "bcryptjs": "3.0.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
